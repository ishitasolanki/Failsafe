# Copy to .env and fill in. Never commit .env.

# Razorpay TEST mode only. Dashboard > Settings > API Keys (Test Mode toggle on).
# Failsafe refuses to start if this is not an rzp_test_ key.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Any ONE of the following. First one found wins, or set LLM_PROVIDER to force.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# Optional overrides
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
